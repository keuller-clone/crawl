wait 3500
tap ENV
wait 300
shot card-lights.png
tap ENV
tap ENV
wait 3500
tap GLO
wait 1500
shot crypt-pixel.png
tap GLO
wait 1500
# two candles snuffed (black keys 1 and 2), then the bell (black key 6)
tapkey b0
wait 300
tapkey b1
wait 1500
shot crypt-key-snuff.png
tapkey b0
tapkey b1
wait 1000
tap PLAY
wait 4000
shot crypt-new.png
spin ALGO -1
wait 200
spin ALGO -1
wait 200
spin ALGO -1
wait 200
spin ALGO -1
wait 200
expect knob0 0
